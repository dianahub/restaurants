.env
.env.local
.env*.local
credentials.json
token.json
google-services.json
GoogleService-Info.plist

# TypeScript
*.tsbuildinfo

# EAS
.easignore

# build artifacts
/build/
/out/
app-example

# logs
logs/
*.log
